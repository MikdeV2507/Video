{
  "name": "hets-whitespace-series",
  "private": true,
  "version": "0.1.0",
  "description": "HETS Data Centre Whitespace video series — animations",
  "scripts": {
    "studio": "remotion studio",
    "render:pilot": "remotion render Ep12RowsAndAisles ../export/ep1.2-rows-and-aisles.mp4",
    "render:review": "remotion render Ep12RowsAndAisles ../export/ep1.2-rows-and-aisles-review.mp4 --props='{\"burnCaptions\":true}'",
    "render:thumb": "remotion still Ep12Thumbnail ../export/ep1.2-thumbnail.png",
    "captions": "tsx scripts/make-srt.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@remotion/cli": "^4.0.537",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
